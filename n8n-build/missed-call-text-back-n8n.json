    {
      "id": "parse-qualification-json",
      "name": "Parse Qualification JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output ?? $input.first().json.text ?? '');\n  const cleaned = raw.replace(/^```(?:json)?/i, '').replace(/```$/i, '').trim();\n  let q;\n  try { q = JSON.parse(cleaned); } catch { throw new Error(`AI response was not valid JSON: ${raw.slice(0, 240)}`); }\n  const required = ['name', 'service_type', 'address', 'urgency_level'];\n  q.complete = required.every(k => typeof q[k] === 'string' && q[k].trim());\n  if (!q.reply) throw new Error('AI response omitted reply');\n  return [{ json: { ...$('Normalize SMS Reply').first().json, ...q } }];"
      },
      "position": [
