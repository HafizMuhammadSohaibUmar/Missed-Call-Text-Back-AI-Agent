    {
      "id": "normalize-missed-call",
      "name": "Normalize Missed Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\n  const status = String(p.CallStatus ?? p.call_status ?? '').toLowerCase();\n  if (!['no-answer', 'busy'].includes(status)) return [];\n  if (!p.From || !p.To || !p.CallSid) throw new Error('Twilio From, To, and CallSid are required');\n  return [{ json: { phone: p.From, business_phone: p.To, call_sid: p.CallSid, call_status: status, received_at: new Date().toISOString() } }];"
      },
      "position": [
        -160,
        -180
      ]
    },
    {
      "id": "recent-missed-calls-supabase-",
      "name": "Recent Missed Calls (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "n8n_missed_calls",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "from_number",
              "condition": "eq",
              "keyValue": "={{ $('Normalize Missed Call').first().json.phone }}"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ hours: 4 }).toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        60,
        -180
      ],
      "alwaysOutputData": true
    },
    {
      "id": "four-hour-duplicate-check",
      "name": "Four-Hour Duplicate Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const call = $('Normalize Missed Call').first().json;\n  const cutoff = Date.now() - 4 * 60 * 60 * 1000;\n  const rows = $input.all().map(i => i.json).filter(r => r.from_number);\n  return [{ json: { ...call, duplicate: rows.some(r => r.call_sid === call.call_sid || (r.from_number === call.phone && Date.parse(r.created_at) >= cutoff)) } }];"
      },
      "position": [
        280,
        -180
      ]
    },
