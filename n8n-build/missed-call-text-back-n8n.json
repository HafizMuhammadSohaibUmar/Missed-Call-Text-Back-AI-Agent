    {
      "id": "normalize-sms-reply",
      "name": "Normalize SMS Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\n  if (!p.From || !p.Body || !p.MessageSid) throw new Error('Twilio From, Body, and MessageSid are required');\n  const text = String(p.Body).trim();\n  const stop = /^(stop|unsubscribe|cancel|quit|end|opt\\s*out)$/i.test(text);\n  return [{ json: { phone: p.From, business_phone: p.To, message: text, message_sid: p.MessageSid, stop } }];"
      },
